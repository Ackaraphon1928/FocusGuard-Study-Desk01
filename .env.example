# Backend variables. Environment variables take effect on service startup.
# The PowerShell launcher sets FOCUSGUARD_MODE. The backend does not read this
# file automatically; set variables in your shell, or use Docker Compose.
FOCUSGUARD_MODE=demo
# FOCUSGUARD_DB=backend/data/focusguard.sqlite3

# Local hardware MQTT broker; optional for the demo.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional InfluxDB v2 time-series mirror; SQLite remains the local journal.
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=focusguard
INFLUX_BUCKET=focusguard

# Optional AWS Bedrock Converse API; cloud consent is OFF in dashboard settings.
# Use normal AWS credential discovery (environment / profile / IAM role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
