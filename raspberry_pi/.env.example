MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# If true, use broker-trusted CA. Never disable TLS verification for a remote broker.
MQTT_CA_CERT=
CAMERA_SOURCE=0
# Use /dev/video0 for USB; for Pi CSI use CAMERA_BACKEND=picamera2 (apt dependency).
CAMERA_BACKEND=opencv
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_VIEW=side
POSE_MODEL=raspberry_pi/models/pose_landmarker_lite.task
CALIBRATION_FILE=raspberry_pi/calibration.json
VISION_PUBLISH_HZ=5
SENSOR_INTERVAL_SECONDS=2
BME280_ADDRESS=0x76
BH1750_ADDRESS=0x23
LAMP_GPIO=18
FAN_GPIO=23
BUZZER_GPIO=24
GPIOZERO_PIN_FACTORY=lgpio
ACTUATOR_WATCHDOG_SECONDS=10
